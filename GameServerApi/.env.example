# Biến môi trường cho GameServerApi (Production)
# Copy file này thành .env hoặc thiết lập trực tiếp trong hệ thống / Docker Compose

# ── Database ──────────────────────────────────────────────────────────────
ConnectionStrings__GameDB=Server=localhost;Port=3306;Database=gamedb;User=gameuser;Password=CHANGE_ME;

# ── JWT ───────────────────────────────────────────────────────────────────
Jwt__Key=CHANGE_ME_MIN_32_CHARS_SECRET_KEY_FOR_JWT_HS256
Jwt__Issuer=GameServerApi
Jwt__Audience=GameClient

# ── Zone API Key (xác thực Gameplay Server -> API) ────────────────────────
ZoneApiKey=CHANGE_ME_ZONE_API_KEY

# CORS whitelist
Cors__AllowedOrigins__0=https://your-client-domain.example

# ── Admin Dashboard ───────────────────────────────────────────────────────
# Tài khoản admin được seed tự động khi khởi động lần đầu.
# Nếu đã tồn tại admin trong DB, giá trị này không có tác dụng.
Admin__Username=admin
Admin__Password=CHANGE_ME_STRONG_PASSWORD
Admin__Email=admin@yourdomain.com
