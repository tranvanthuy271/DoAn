# ============================================================
# .env.example  —  Copy thành .env và điền giá trị thực
# KHÔNG commit file .env lên git!
# ============================================================

# ── MariaDB ─────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpass_thay_doi_ngay
MYSQL_DATABASE=gamedb
MYSQL_USER=gameuser
MYSQL_PASSWORD=gamepass_thay_doi_ngay

# ── JWT Secret (tối thiểu 32 ký tự ngẫu nhiên) ───────────────
# Sinh bằng: openssl rand -base64 48
JWT_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_DAI_IT_NHAT_32_KY_TU

# ── Zone API Key (dùng giữa Unity Server và GameServerApi) ───
# Sinh bằng: openssl rand -hex 32
ZONE_API_KEY=THAY_BANG_ZONE_API_KEY_NGAU_NHIEN

# ── VPS / Network ────────────────────────────────────────────
VPS_IP=1.2.3.4
GAME_SERVER_PORT=7777
