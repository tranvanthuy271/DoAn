' Dán trực tiếp vào diagrams.net / draw.io web:
' Arrange -> Insert -> Advanced -> PlantUML...
@startuml MutantsArenaAuthCharacter
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam packageStyle rectangle

actor "Khách" as Guest
actor "Người chơi" as Player
actor "Máy chủ gameplay /\nNetcode server" as Server

rectangle "Hệ thống Mutants Arena" {
  usecase "Đăng ký\ntài khoản" as UC01
  usecase "Đăng nhập" as UC02
  usecase "Tạo nhân vật\nvà vào game" as UC03
  usecase "Xác thực kết nối /\ngán zone ban đầu" as UNetAuth
}

Guest --> UC01
Guest --> UC02
Player --> UC02
Player --> UC03
Server --> UNetAuth
UC03 .> UC02 : <<include>>
UC03 .> UNetAuth : <<include>>
@enduml
